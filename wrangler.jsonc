{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "6o2f",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",
  "account_id": "c0eca744e90e0cef2e720650afcdf4c5",
  "workers_dev": false,
  // One Worker serves the apex (dashboard + login) and every tool subdomain; src/index.ts routes by hostname.
  "routes": [
    // The apex is a Custom Domain; every <tool>.6o2f.dev goes through the wildcard route below (one DNS record, no per-tool setup,
    // and no 100-custom-domain limit). New tools need only an entry in src/tools/index.ts.
    { "pattern": "6o2f.dev", "custom_domain": true },
    { "pattern": "*.6o2f.dev/*", "zone_name": "6o2f.dev" },
  ],
  // Email Routing catch-all (*@6o2f.dev -> this Worker's email() handler, src/tools/mail) is set via the Cloudflare API,
  // not "addresses": wrangler refuses to deploy non-interactively over a rule it did not create.
  // Daily retention sweeps (mail, drop) and the 5-minute uptime checks.
  "triggers": { "crons": ["17 3 * * *", "*/5 * * * *"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "6o2f", "database_id": "863cdc76-1e6c-4f53-8900-adbf4df7b742", "migrations_dir": "migrations" },
    // Existing mail database (moved from the 6o2f-mail Worker unchanged). Its migrations: pnpm exec wrangler d1 migrations apply MAILDB
    { "binding": "MAILDB", "database_name": "6o2f-mail", "database_id": "41d33084-fd96-49e8-88c5-724a37e2dc46", "migrations_dir": "migrations-mail" },
  ],
  "kv_namespaces": [
    { "binding": "PASTE", "id": "bd9bd894c20e449eb9de0336a6e104c0" },
    { "binding": "LINKS", "id": "35e06ca756834748aab76af143418be4" },
    { "binding": "CLIP", "id": "8b9e0c0b13d043a4b102eec546b9ebdd" },
    // Bot guard: ban:<ip> = flagged by a honeypot (24 h TTL). See src/guard.ts.
    { "binding": "GUARD", "id": "59ba648019ab49a696c92206b596157a" },
  ],
  "r2_buckets": [
    { "binding": "DROP", "bucket_name": "6o2f-drop" },
    // Raw .eml per message; MAILDB holds only the listing fields.
    { "binding": "MAIL", "bucket_name": "6o2f-mail" },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "HOOK", "class_name": "HookInbox" },
      { "name": "SEND", "class_name": "SendRoom" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["HookInbox"] },
    { "tag": "v2", "new_sqlite_classes": ["SendRoom"] },
  ],
  "vars": {
    "RETENTION_DAYS": "30",
    "DOMAIN": "6o2f.dev",
    "DEV": "",
    "ADMIN_IDS": "219517248388202498",
    "DISCORD_CLIENT_ID": "1555044010152689765",
  },
  // Secrets: DISCORD_CLIENT_SECRET, SESSION_SECRET (also salts the analytics visitor hashes, src/stats.ts).
  // Optional: DISCORD_BOT_TOKEN (admin: names for users added by id), AI_MODEL (ai tool: overrides the default model).
  // Static files: shared UI in public/_/, client-only tools in public/_t/. Everything else hits the Worker.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/*", "!/_/*"] },
  // Workers AI (the ai tool; sign-in only, per-user daily cap)
  "ai": { "binding": "AI" },
  "observability": { "enabled": true },
  "dev": { "ip": "127.0.0.1", "inspector_port": 9341, "port": 8841, "host": "localhost:8841", "upstream_protocol": "http" },
}
