# Static files under /_/ skip the Worker (wrangler.jsonc run_worker_first), so they get their security headers here.
# The Content-Security-Policy and Permissions-Policy below must stay identical to the HTML ones in src/index.ts.
# Browsers ignore CSP on JS/CSS, so one rule covers the whole path.
/_/*
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Referrer-Policy: same-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-YynjG5lDd9Ulbw7xL2D8gfwkg3qBmx2fWH1xigAR1nM=' https://static.cloudflareinsights.com; connect-src 'self' wss://*.6o2f.dev https://cloudflareinsights.com; img-src 'self' data: https://cdn.discordapp.com; font-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'none'; form-action 'self' https://discord.com
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

# Vite output is content-hashed, so it never changes under the same name.
/_/mail/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
