{
  "version": "0.2",
  "language": "en,en-GB",
  "dictionaryDefinitions": [{ "name": "project-words", "path": "./project-words.txt", "addWords": true }],
  "dictionaries": ["project-words", "typescript", "node", "html", "css", "fonts", "softwareTerms", "companies", "misc"],
  "ignorePaths": [
    "node_modules",
    ".wrangler",
    "pnpm-lock.yaml",
    "**/pnpm-lock.yaml",
    "worker-configuration.d.ts",
    "public/_/mail",
    "**/vendor/**",
    "web-mail/dist",
    "brand",
    "*.svg",
    "project-words.txt"
  ],
  "ignoreRegExpList": ["/[A-Za-z0-9+/=_-]{32,}/g", "/sha256-[A-Za-z0-9+/=]+/g", "/\\\\u[0-9a-fA-F]{4}/g", "/#[0-9a-fA-F]{3,8}\\b/g"]
}
